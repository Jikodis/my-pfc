---
/**
 * One day's set 2+1 on the home page: the critical picks, then the bonus, each with
 * the line saying why it matters. `doneButtons` adds Done and Done in chat to every
 * pick not yet done; the page passes it for today's picks only, because tomorrow's
 * cannot be finished yet. `done` comes from the daily-focus record (`home_data.py`).
 */
import type { HomePick } from '../lib/computed'
import { PROMPTS, chatPrompt } from '../lib/chat/prompts'
import ActionButton from './ActionButton.astro'
import WhyLine from './WhyLine.astro'

interface Props {
  picks: { critical: HomePick[]; bonus: HomePick | null }
  doneButtons: boolean
}
const { picks, doneButtons } = Astro.props
const donePrompt = (t: HomePick) => chatPrompt(PROMPTS.complete, { title: t.title, id: t.id })
---
<ul class="plain picks">
  {picks.critical.map((t) => (
    <li title={t.id}>
      <span class={t.done ? 'pick-title done' : 'pick-title'}>{t.title}</span>
      {doneButtons && !t.done && (
        <ActionButton action="complete-task" id={t.id} label="Done" name={t.title} confirm="Mark done?">
          <button type="button" class="act" data-chat-prompt={donePrompt(t)} aria-label={`Done in chat: ${t.title}`}>Done in chat</button>
        </ActionButton>
      )}
      <WhyLine why={t.why} />
    </li>
  ))}
  {picks.bonus && (
    <li title={picks.bonus.id}>
      <span class="tag">bonus</span> <span class={picks.bonus.done ? 'pick-title done' : 'pick-title'}>{picks.bonus.title}</span>
      {doneButtons && !picks.bonus.done && <ActionButton action="complete-task" id={picks.bonus.id} label="Done" name={picks.bonus.title} confirm="Mark done?" />}
      <WhyLine why={picks.bonus.why} />
    </li>
  )}
</ul>
