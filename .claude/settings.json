{
  "permissions": {
    "allow": [],
    "deny": []
  },
  "extraKnownMarketplaces": {
    "trmnl-agent-skills": {
      "source": { "source": "github", "repo": "usetrmnl/trmnl-agent-skills" },
      "autoUpdate": true
    }
  },
  "enabledPlugins": { "trmnl@trmnl-agent-skills": true },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/scripts/hook-session-date.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/scripts/hook-user-prompt-date.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/scripts/hook-validate.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/scripts/hook-stop-session-ledger.sh"
          }
        ]
      }
    ]
  }
}
