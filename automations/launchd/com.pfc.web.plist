<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Replace /Users/YOUR_USER/path/to/your-pfc with your clone's absolute path and
     YOUR_USER with your macOS account name before copying this to ~/Library/LaunchAgents/
     (docs/install/web-ui.md). -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.pfc.web</string>
  <key>ProgramArguments</key>
  <array><string>/bin/bash</string><string>/Users/YOUR_USER/path/to/your-pfc/automations/scripts/run-web.sh</string></array>
  <key>WorkingDirectory</key><string>/Users/YOUR_USER/path/to/your-pfc</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOST</key><string>127.0.0.1</string>
    <key>PORT</key><string>4323</string>
    <key>LOCAL_TZ</key><string>America/Denver</string>
    <!-- The folder claude installs into, then Homebrew: node, npm, git, gh, and python3
         resolve from there. jq comes from /usr/bin. -->
    <key>PATH</key><string>/Users/YOUR_USER/.local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <!-- The claude the chat panel starts. -->
    <key>PFC_CLAUDE</key><string>/Users/YOUR_USER/.local/bin/claude</string>
    <!-- claude finds its login in the keychain under this account name. Without it,
         `claude auth status` reports loggedIn false. -->
    <key>USER</key><string>YOUR_USER</string>
    <!-- The interpreter that has PyYAML. /usr/bin/python3 does not. -->
    <key>PFC_PYTHON</key><string>/opt/homebrew/bin/python3</string>
    <!-- Optional: push as this gh account, reading its token from the gh keyring per
         push, never stored. Leave it out to push with your normal git credentials.
    <key>PFC_PUSH_GH_USER</key><string>your-github-user</string>
    -->
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <!-- A build that can never succeed would otherwise restart every 10 seconds. -->
  <key>ThrottleInterval</key><integer>30</integer>
  <key>StandardOutPath</key><string>/tmp/pfc-web.log</string>
  <key>StandardErrorPath</key><string>/tmp/pfc-web.log</string>
</dict>
</plist>
