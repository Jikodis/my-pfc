<div class="layout layout--col layout--top">
  <div class="col gap--medium stretch-x">
    <span class="label">The last 30 days</span>
    {% for t in rows %}
      <div class="flex flex--col flex--left">
        <span class="title title--small">{% render "status_shape", status: t.status %} {{ t.status }} {{ t.name }}</span>
        <span class="label" data-clamp="2">{{ t.why }}</span>
      </div>
    {% endfor %}
    {% if green.size > 0 %}<span class="label">{% render "status_shape", status: "GREEN" %} On track: {{ green | join: ", " }}</span>{% endif %}
  </div>
</div>

<div class="title_bar">
  <span class="title">{{ title }}</span>
  <span class="instance">{{ date }}</span>
</div>
