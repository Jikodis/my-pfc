<div class="layout layout--col layout--stretch">
  <div class="flex flex--col gap--space-between stretch-y w--full">
    <span class="label label--small label--gray 1bit:text--black w--full" data-clamp="2">{{ horizon }}</span>
    {% for row in rows %}
      <div class="flex flex--col flex--left w--full">
        <div class="flex flex--row flex--between w--full">
          <span class="title title--base" data-clamp="1">{{ row.name }}</span>
          <span class="label {% if row.status == 'RED' %}label--filled{% else %}label--outline{% endif %} no-shrink">{{ row.status }}</span>
        </div>
        <span class="description" data-clamp="1">{{ row.why }}</span>
      </div>
    {% else %}
      <span class="label">No trend data yet.</span>
    {% endfor %}
  </div>
</div>

<div class="title_bar">
  <span class="title">{{ title }}</span>
  <span class="instance">{{ date }}</span>
</div>
