<div class="layout layout--col gap">
  <div class="col gap--small">
    <div class="grid">
      <div class="col col--span-6">
        <div class="item">
          <div class="meta"></div>
          <div class="content">
            <span class="value value--large" data-fit-value="true">{{ avg_rating }}</span>
            <span class="label label--small">avg rating 7d</span>
          </div>
        </div>
      </div>
      <div class="col col--span-6">
        <div class="item">
          <div class="meta"></div>
          <div class="content">
            <span class="value value--large" data-fit-value="true">{{ avg_sleep }}</span>
            <span class="label label--small">avg sleep 7d</span>
          </div>
        </div>
      </div>
    </div>
    <div class="grid">
      <div class="col col--span-6">
        <div class="item">
          <div class="meta"></div>
          <div class="content">
            <span class="value value--large" data-fit-value="true">{{ exercise }}</span>
            <span class="label label--small">exercise 7d</span>
          </div>
        </div>
      </div>
      <div class="col col--span-6">
        <div class="item">
          <div class="meta"></div>
          <div class="content">
            <span class="value value--large" data-fit-value="true">{{ sleep_debt }}</span>
            <span class="label label--small">sleep debt now</span>
          </div>
        </div>
      </div>
    </div>
    <span class="label label--small label--gray" data-clamp="2">{{ exercise_line }}</span>
  </div>
</div>

<div class="title_bar">
  <span class="title">Trends - 30 days</span>
</div>
