<div class="layout layout--col layout--top gap--small">
  <div class="col gap--small">
    <span class="label label--small label--gray 1bit:text--black" data-clamp="1">{{ horizon }}</span>
    <div class="columns" data-overflow-max-cols="2">
      <div class="column">
        {% for row in rows %}
          <div class="item">
            <div class="meta"></div>
            <div class="content">
              <div class="flex flex--row flex--between">
                <span class="label" data-clamp="1">{{ row.name }}</span>
                <span class="label label--small {% if row.status == 'RED' %}label--filled{% else %}label--outline{% endif %} no-shrink">{{ row.status }}</span>
              </div>
              <span class="label label--small label--gray 1bit:text--black" data-clamp="1">{{ row.why }}</span>
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</div>

<div class="title_bar">
  <span class="title">{{ title }}</span>
  <span class="instance">{{ date }}</span>
</div>
