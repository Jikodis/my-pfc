<div class="layout layout--col layout--top">
  <div class="col gap--small stretch-x">
    {% for t in rows limit: 2 %}
      <div class="flex flex--row flex--left gap--xsmall"><span class="title title--small no-shrink">{% render "status_shape", status: t.status %}</span><span class="title title--small" data-clamp="1">{{ t.status }} {{ t.name }} - {{ t.why }}</span></div>
    {% endfor %}
    {% if green.size > 0 %}<span class="label">{% render "status_shape", status: "GREEN" %} On track: {{ green | join: ", " }}</span>{% endif %}
  </div>
</div>

<div class="title_bar">
  <span class="title">{{ title }}</span>
  <span class="instance">{{ date }}</span>
</div>
