<div class="layout layout--col layout--center">
  <div class="flex flex--col flex--center-x gap--large w--full">
    <span class="label lg:label--large">The last 30 days</span>
    {% for t in rows %}
      <div class="flex flex--col flex--left gap--xsmall">
        <div class="flex flex--row flex--left gap--small">
          {% render "status_chip", status: t.status, size: "lg:label--large" %}
          <span class="title title--xlarge lg:title--xxlarge">{{ t.name }}</span>
        </div>
        <span class="title title--base lg:title--large">{{ t.why }}</span>
      </div>
    {% else %}
      {% if count > 0 %}<span class="title title--xlarge lg:title--xxlarge">{% render "status_shape", status: "GREEN" %} All {{ count }} on track</span>{% else %}<span class="title title--base">No trend data yet.</span>{% endif %}
    {% endfor %}
    {% if rows.size > 0 and green.size > 0 %}
      <span class="title title--base lg:title--large">{% render "status_shape", status: "GREEN" %} On track: {{ green | join: ", " }}</span>
    {% endif %}
  </div>
</div>

<div class="title_bar">
  <span class="title">{{ title }}</span>
  <span class="instance">{{ date }}</span>
</div>
