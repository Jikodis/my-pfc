<div class="layout layout--col layout--stretch">
  <div class="flex flex--col gap--space-between stretch-y w--full">
    <span class="label label--base lg:label--large label--gray w--full">{{ horizon }}</span>
    {% for row in rows %}
      <div class="grid w--full">
        <div class="col col--span-4">
          <span class="title title--xlarge lg:title--xxlarge" data-clamp="1">{{ row.name }}</span>
        </div>
        <div class="col col--span-2">
          <span class="label label--xlarge lg:label--xxlarge {% if row.status == 'RED' %}label--filled{% else %}label--outline{% endif %}">{{ row.status }}</span>
        </div>
        <div class="col col--span-6">
          <span class="description description--large lg:description--xlarge" data-clamp="2">{{ row.why }}</span>
        </div>
      </div>
    {% else %}
      <span class="title title--xlarge">No trend data yet.</span>
    {% endfor %}
  </div>
</div>

<div class="title_bar">
  <span class="title">{{ title }}</span>
  <span class="instance">{{ date }}</span>
</div>
