<div class="layout layout--col layout--stretch gap--space-between">
  {% for row in rows %}
    <div class="flex flex--row flex--between">
      <span class="label" data-clamp="1">{{ row.name }}</span>
      <span class="label label--small {% if row.status == 'RED' %}label--filled{% else %}label--outline{% endif %} no-shrink">{{ row.status }}</span>
    </div>
  {% else %}
    <span class="label">No trend data yet.</span>
  {% endfor %}
</div>

<div class="title_bar">
  <span class="title">{{ title }}</span>
  <span class="instance">{{ date }}</span>
</div>
