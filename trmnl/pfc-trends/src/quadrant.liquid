<div class="layout layout--col layout--top">
  <div class="col gap--small stretch-x">
    {% for t in rows limit: 2 %}
      <div class="flex flex--row flex--left gap--xsmall"><span class="title title--small no-shrink">{% render "status_shape", status: t.status %}</span><span class="title title--small" data-clamp="1">{{ t.name }}</span></div>
      <span class="label" data-clamp="1">{{ t.why }}</span>
    {% endfor %}
    <span class="label">{{ green.size }} of {{ count }} on track</span>
  </div>
</div>

<div class="title_bar">
  <span class="title">{{ title }}</span>
  <span class="instance">{{ date }}</span>
</div>
