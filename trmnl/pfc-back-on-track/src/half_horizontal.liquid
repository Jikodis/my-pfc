{% if all_clear %}
  <div class="layout layout--col layout--center">
    <span class="value value--large">ALL ON TRACK</span>
  </div>
{% else %}
  <div class="layout layout--col gap--small">
    <div class="grid">
      <div class="col col--span-7 gap--small">
        <span class="title title--small">Focus</span>
        {% for item in focus limit: 3 %}
          <span class="label label--small" data-clamp="1">{{ item.status }} - {{ item.title }}</span>
        {% else %}
          <span class="label label--small label--gray">all on track</span>
        {% endfor %}
      </div>
      <div class="col col--span-5 gap--small">
        <span class="title title--small">Habits behind</span>
        {% for item in habits limit: 3 %}
          <span class="label label--small" data-clamp="1">{{ item.week }} - {{ item.title }}</span>
        {% else %}
          <span class="label label--small label--gray">no gaps</span>
        {% endfor %}
      </div>
    </div>
  </div>
{% endif %}

<div class="title_bar">
  <span class="title">Back on Track</span>
  {% unless all_clear %}
    <span class="instance">{{ total }}</span>
  {% endunless %}
</div>
