<div class="layout layout--col layout--top">
  <div class="col gap--small stretch-x">
    <span class="value value--large">{{ green }} of {{ count }}</span>
    <span class="label">areas green</span>
    <span class="label" data-clamp="2">{% for r in rows %}{{ r.label }}{% unless forloop.last %}, {% endunless %}{% endfor %}</span>
  </div>
</div>

<div class="title_bar">
  <span class="title">{{ title }}</span>
  <span class="instance">{{ date }}</span>
</div>
