<div class="layout layout--col gap--small">
  <div class="col gap--small">
    {% for group in groups %}
      <div class="flex flex--row flex--left gap--small">
        <span class="title title--small">{{ group.label }}</span>
        <span class="label label--small">{{ group.green }} of {{ group.rows.size }} GREEN</span>
      </div>
      {% for row in group.rows limit: 3 %}
        <div class="flex flex--row flex--left gap--small">
          {% render "status_chip", status: row.status, size: "label--small" %}
          <span class="label label--small" data-clamp="1">{{ row.label }}</span>
        </div>
      {% endfor %}
    {% endfor %}
  </div>
</div>

<div class="title_bar">
  <span class="title">{{ title }}</span>
</div>
