<div class="layout layout--col gap">
  <div class="col gap--small">
    <span class="label label--small lg:label--base label--gray 1bit:text--black">{{ horizon }}</span>
    <div class="grid">
      {% for group in groups %}
        <div class="col col--span-6 gap--[3px]">
          {% render "group_head", group: group, title_size: "title--base lg:title--large", size: "label--base lg:label--large" %}
          {% for row in group.rows limit: 14 %}
            <div class="flex flex--row flex--left gap--small">
              {% render "status_chip", status: row.status, size: "label--base lg:label--large" %}
              <span class="label lg:label--large no-shrink">{{ row.label }}</span>
              {% if row.note != "" %}
                <span class="label lg:label--large label--gray 1bit:text--black" data-clamp="1">{{ row.note }}</span>
              {% endif %}
            </div>
          {% endfor %}
        </div>
      {% endfor %}
    </div>
  </div>
</div>

<div class="title_bar">
  <span class="title">{{ title }}</span>
  <span class="instance">{{ date }}</span>
</div>
