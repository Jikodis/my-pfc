<div class="layout layout--col layout--top">
  <div class="col gap--small stretch-x">
    {% if plate %}<span class="title title--small">{% render "status_shape", status: plate.status %} {{ plate.committed }} of {{ plate.free }} free waking hours a week committed</span>{% endif %}
    <span class="label" data-clamp="2">Life wheel {{ green }} of {{ count }} green. Needs a look: {% for r in rows %}{{ r.label }}{% unless forloop.last %}, {% endunless %}{% endfor %}</span>
    {% if rooms_count > 0 %}<span class="label">Household: {{ rooms_green }} of {{ rooms_count }} rooms green</span>{% endif %}
  </div>
</div>

<div class="title_bar">
  <span class="title">{{ title }}</span>
  <span class="instance">{{ date }}</span>
</div>
