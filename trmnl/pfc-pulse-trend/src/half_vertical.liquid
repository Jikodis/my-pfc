<div class="layout layout--col gap">
  <div class="col gap--small">
    <span class="title title--small">{{ green_days }}/{{ window }} days primed for a great day</span>
    <span class="label label--small label--gray">30-day status - days on target (higher is better)</span>
    {% for lever in levers limit: 5 %}
      <span class="label label--small" data-clamp="1">{{ lever.status }} - {{ lever.label }} {{ lever.on }}/{{ lever.n }}</span>
    {% endfor %}
    {% if chronic %}
      <span class="label label--small label--gray" data-clamp="2">Chronic: {{ chronic.label }}, on target only {{ chronic.on }}/{{ chronic.n }}</span>
    {% endif %}
  </div>
</div>

<div class="title_bar">
  <span class="title">Pulse Trend</span>
</div>
