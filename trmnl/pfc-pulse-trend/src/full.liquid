<div class="layout layout--col gap">
  <div class="grid">
    <div class="col col--span-7 gap--small">
      <table class="table table--small">
        <thead>
          <tr>
            <th class="w--20"><span class="label label--small label--gray">30 days</span></th>
            <th><span class="label label--small label--gray">Lever</span></th>
            <th class="w--24"><span class="label label--small label--gray">On target</span></th>
            <th class="w--20"><span class="label label--small label--gray">Goal</span></th>
          </tr>
        </thead>
        <tbody>
          {% for lever in levers %}
            <tr>
              <td class="w--20"><span class="label label--small lg:label--base">{{ lever.status }}</span></td>
              <td><span class="label label--small lg:label--base" data-clamp="1">{{ lever.label }}</span></td>
              <td class="w--24"><span class="value value--xsmall lg:value--small value--tnums">{{ lever.on }}/{{ lever.n }}</span></td>
              <td class="w--20"><span class="label label--small label--gray">{{ lever.target }}</span></td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
    <div class="col col--span-5 gap--small">
      <div class="item">
        <div class="meta"></div>
        <div class="content">
          <span class="value value--xlarge">{{ green_days }}/{{ window }}</span>
          <span class="label label--small">days primed for a great day</span>
        </div>
      </div>
      {% if chronic %}
        <div class="item">
          <div class="meta"></div>
          <div class="content">
            <span class="title title--small lg:title--base" data-clamp="2">{{ chronic.status }} - {{ chronic.label }}, on target only {{ chronic.on }}/{{ chronic.n }}</span>
            <span class="label label--small lg:label--base" data-clamp="5">{{ chronic.fix }}</span>
          </div>
        </div>
      {% else %}
        <span class="label">The pulse is holding steady.</span>
      {% endif %}
    </div>
  </div>
</div>

<div class="title_bar">
  <span class="title">Pulse Trend - {{ window }} days (counts are good days; higher is better)</span>
</div>
