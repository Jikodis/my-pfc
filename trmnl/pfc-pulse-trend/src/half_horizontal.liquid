<div class="layout layout--col gap--small">
  <div class="grid">
    <div class="col col--span-4">
      <div class="item">
        <div class="meta"></div>
        <div class="content">
          <span class="value value--large">{{ green_days }}/{{ window }}</span>
          <span class="label label--small">days primed for a great day</span>
        </div>
      </div>
    </div>
    <div class="col col--span-8">
      {% if chronic %}
        <div class="item">
          <div class="meta"></div>
          <div class="content">
            <span class="title title--small" data-clamp="1">{{ chronic.status }} - {{ chronic.label }}, on target only {{ chronic.on }}/{{ chronic.n }}</span>
            <span class="label label--small" data-clamp="3">{{ chronic.fix }}</span>
          </div>
        </div>
      {% else %}
        <span class="label">The pulse is holding steady.</span>
      {% endif %}
    </div>
  </div>
</div>

<div class="title_bar">
  <span class="title">Pulse Trend - {{ window }} days</span>
</div>
