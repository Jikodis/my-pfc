<div class="layout layout--col gap--small">
  <div class="col gap--xsmall">
    <span class="value value--large">{{ green_days }}/{{ window }} primed</span>
    {% if chronic %}
      <span class="label label--small" data-clamp="2">{{ chronic.status }} - {{ chronic.label }}, on target only {{ chronic.on }}/{{ chronic.n }}</span>
    {% else %}
      <span class="label label--small">Holding steady.</span>
    {% endif %}
  </div>
</div>

<div class="title_bar">
  <span class="title">Pulse Trend</span>
</div>
