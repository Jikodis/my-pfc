<div class="layout layout--col layout--top gap--small">
  <div class="grid">
    {% for group in groups limit: 1 %}
      <div class="col col--span-4">
        <span class="value value--large">{{ group.logged }}/{{ group.count }}</span>
        <span class="label label--small">{{ group.label | downcase }} logged</span>
      </div>
      <div class="col col--span-8 gap--xsmall">
        {% assign shown = 0 %}
        {% for row in group.rows %}
          {% if row.state == "Not logged" and shown < 5 %}
            <span class="label" data-clamp="1">{{ row.title }}</span>
            {% assign shown = shown | plus: 1 %}
          {% endif %}
        {% endfor %}
      </div>
    {% endfor %}
  </div>
</div>

<div class="title_bar">
  <span class="title">{{ title }}</span>
  <span class="instance">{{ date }}</span>
</div>
