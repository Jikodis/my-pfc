<div class="layout layout--col layout--top">
  <div class="col gap--small stretch-x">
    <span class="value value--large">{{ logged }} of {{ count }}</span>
    <span class="label">daily habits logged today</span>
    <span class="label" data-clamp="2">{% for r in todo %}{{ r.title }}{% unless forloop.last %}, {% endunless %}{% endfor %}</span>
  </div>
</div>

<div class="title_bar">
  <span class="title">{{ title }}</span>
  <span class="instance">{{ date }}</span>
</div>
