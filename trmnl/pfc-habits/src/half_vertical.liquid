<div class="layout layout--col layout--top">
  <div class="col gap--medium stretch-x">
    <div class="flex flex--col flex--left">
      <span class="value value--large">{{ logged }} of {{ count }}</span>
      <span class="label">daily habits logged today</span>
    </div>
    <div class="flex flex--col flex--left gap--xsmall">
      {% for r in todo %}
        <span class="title title--small" data-clamp="1">{{ r.title }}</span>
      {% else %}
        <span class="title title--small">All logged today.</span>
      {% endfor %}
    </div>
    {% if monthly_count > 0 %}<span class="label">Monthly: {{ monthly_logged }} of {{ monthly_count }} logged</span>{% endif %}
  </div>
</div>

<div class="title_bar">
  <span class="title">{{ title }}</span>
  <span class="instance">{{ date }}</span>
</div>
