<div class="layout layout--col layout--top gap--small">
  <div class="col gap--small">
    <span class="label label--small label--gray 1bit:text--black" data-clamp="1">{{ horizon }}</span>
    {% for group in groups %}
      <span class="title title--small">{{ group.label }} {{ group.logged }}/{{ group.count }}</span>
      {% assign shown = 0 %}
      {% if group.label == "Daily" %}{% assign cap = 9 %}{% else %}{% assign cap = 3 %}{% endif %}
      {% for row in group.rows %}
        {% if row.state == "Not logged" and shown < cap %}
          <div class="flex flex--row flex--between">
            <span class="label" data-clamp="1">{{ row.title }}</span>
            <span class="label label--small label--filled no-shrink">Not logged</span>
          </div>
          {% assign shown = shown | plus: 1 %}
        {% endif %}
      {% endfor %}
      {% for row in group.rows %}
        {% if row.state != "Not logged" and shown < cap %}
          <div class="flex flex--row flex--between">
            <span class="label label--gray" data-clamp="1">{{ row.title }}</span>
            <span class="label label--small label--gray 1bit:text--black no-shrink">{{ row.state }}</span>
          </div>
          {% assign shown = shown | plus: 1 %}
        {% endif %}
      {% endfor %}
    {% endfor %}
  </div>
</div>

<div class="title_bar">
  <span class="title">{{ title }}</span>
  <span class="instance">{{ date }}</span>
</div>
