<div class="layout layout--col gap--small">
  <div class="columns" data-overflow-max-cols="2">
    <div class="column">
      {% for habit in daily %}
        <div class="item">
          <div class="meta"></div>
          <div class="content">
            <span class="label label--small" data-clamp="1">{% if habit.done %}{{ done_mark }}{% else %}{{ open_mark }}{% endif %} {{ habit.title }}</span>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</div>

<div class="title_bar">
  <span class="title">Habits</span>
  <span class="instance">{{ daily_done }}/{{ daily_total }} today</span>
</div>
