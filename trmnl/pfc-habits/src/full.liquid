<div class="layout layout--col layout--top gap">
  <div class="col gap--small">
    <span class="label label--small lg:label--base label--gray 1bit:text--black">{{ horizon }}</span>
    <div class="grid">
      {% for group in groups %}
        <div class="col {% if group.label == 'Daily' %}col--span-7{% else %}col--span-5{% endif %} gap">
          <span class="title title--base lg:title--large">{{ group.label }} {{ group.logged }}/{{ group.count }} logged today</span>
          <div class="divider"></div>
          {% for row in group.rows %}
            {% if row.state == "Not logged" %}
              <div class="flex flex--row flex--between">
                <span class="label label--large lg:label--xlarge" data-clamp="1">{{ row.title }}</span>
                <span class="label label--base lg:label--large label--filled no-shrink">{{ row.state }}</span>
              </div>
            {% endif %}
          {% endfor %}
          {% for row in group.rows %}
            {% unless row.state == "Not logged" %}
              <div class="flex flex--row flex--between">
                <span class="label label--large lg:label--xlarge label--gray" data-clamp="1">{{ row.title }}</span>
                <span class="label label--base lg:label--large label--gray no-shrink">{{ row.state }}</span>
              </div>
            {% endunless %}
          {% endfor %}
        </div>
      {% else %}
        <div class="col col--span-12">
          <span class="label label--gray">No habits.</span>
        </div>
      {% endfor %}
    </div>
  </div>
</div>

<div class="title_bar">
  <span class="title">{{ title }}</span>
  <span class="instance">{{ date }}</span>
</div>
