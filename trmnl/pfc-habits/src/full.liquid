<div class="layout layout--col layout--top">
  <div class="grid w--full">
    <div class="col col--span-4 gap--large">
      <div class="flex flex--col flex--left">
        <span class="value value--xlarge lg:value--xxlarge">{{ logged }} of {{ count }}</span>
        <span class="label lg:label--large">daily habits logged today</span>
        {% if automatic > 0 %}<span class="label lg:label--large">{{ automatic }} more log themselves</span>{% endif %}
      </div>
      {% if monthly_count > 0 %}
        <div class="flex flex--col flex--left gap--xsmall">
          <span class="title title--small lg:title--base">Monthly: {{ monthly_logged }} of {{ monthly_count }} logged</span>
          {% if monthly_todo != "" %}<span class="label lg:label--large" data-clamp="3">To do: {{ monthly_todo }}</span>{% endif %}
        </div>
      {% endif %}
    </div>
    <div class="col col--span-8 gap--medium">
      <span class="title title--small lg:title--base">Still to log today</span>
      {% if todo.size > 0 %}
        <div class="grid grid--cols-2 gap--medium">
          {% for r in todo %}
            <div class="flex flex--col flex--left">
              <span class="title title--small lg:title--base" data-clamp="1">{{ r.title }}</span>
              {% if r.yesterday %}<span class="label lg:label--large">logged yesterday</span>{% endif %}
            </div>
          {% endfor %}
        </div>
      {% else %}
        <span class="title title--base lg:title--large">{% render "status_shape", status: "GREEN" %} All logged today.</span>
      {% endif %}
    </div>
  </div>
</div>

<div class="title_bar">
  <span class="title">{{ title }}</span>
  <span class="instance">{{ date }}</span>
</div>
