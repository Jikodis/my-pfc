<div class="layout layout--col layout--top">
  <div class="col gap--medium stretch-x">
    <div class="flex flex--row flex--left gap--small">
      <span class="value value--large lg:value--xlarge">{{ count }}</span>
      <span class="label lg:label--large">active{% if stalled > 0 %}, {{ stalled }} stalled{% endif %}</span>
    </div>
    {% for p in active %}
      <div class="flex flex--col flex--left gap--xsmall w--full">
        <div class="flex flex--row flex--between w--full">
          <span class="title title--small lg:title--base" data-clamp="1">{{ p.name }}</span>
          <span class="label lg:label--large no-shrink">{% if p.idle != "" %}{{ p.idle }} - {% endif %}{{ p.pct }}% done</span>
        </div>
        <div class="progress-bar progress-bar--small w--full">
          <div class="track"><div class="fill w--[{{ p.pct }}cqw]"></div></div>
        </div>
        <span class="label lg:label--large" data-clamp="1">{% if p.next != "" %}Next: {{ p.next }}{% else %}No next task.{% endif %}</span>
      </div>
    {% else %}
      <span class="title title--base lg:title--large">No active projects.</span>
    {% endfor %}
    <span class="label lg:label--large">{% if more > 0 %}{{ more }} more active - {% endif %}{{ other }} parked and on deck</span>
  </div>
</div>

<div class="title_bar">
  <span class="title">{{ title }}</span>
  <span class="instance">{{ date }}</span>
</div>
