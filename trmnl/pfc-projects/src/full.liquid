<div class="layout layout--col gap">
  <div class="col gap--medium stretch-x">
    <span class="description lg:description--large">{{ horizon }} {{ count }} active, {{ on_deck }} on deck, {{ parked }} parked.</span>
    {% for p in active limit: 5 %}
      <div class="flex flex--col flex--left gap--xsmall w--full">
        <div class="flex flex--row flex--between w--full">
          <span class="title title--small lg:title--base" data-clamp="1">{{ p.name }}</span>
          <span class="label lg:label--large">{{ p.pct }}% done</span>
        </div>
        <div class="progress-bar progress-bar--small w--full">
          <div class="track"><div class="fill w--[{{ p.pct }}cqw]"></div></div>
        </div>
        <span class="label lg:label--large" data-clamp="1">{% if p.next != "" %}Next: {{ p.next }}{% else %}No next task.{% endif %}</span>
      </div>
    {% else %}
      <span class="title title--small lg:title--base">No active projects.</span>
    {% endfor %}
  </div>
</div>

<div class="title_bar">
  <span class="title">{{ title }}</span>
  <span class="instance">{{ date }}</span>
</div>
