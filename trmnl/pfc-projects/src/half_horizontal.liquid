<div class="layout layout--col gap--small">
  <div class="col gap--xsmall stretch-x">
    <span class="label label--small" data-clamp="1">{{ horizon }} {{ on_deck }} on deck, {{ parked }} parked.</span>
    {% for p in active limit: 5 %}
      <div class="grid">
        <div class="col col--span-1"><span class="label">{{ p.pct }}%</span></div>
        <div class="col col--span-5"><span class="label" data-clamp="1">{{ p.name }}</span></div>
        <div class="col col--span-6"><span class="label label--small" data-clamp="1">Next: {{ p.next }}</span></div>
      </div>
    {% else %}
      <span class="label">No active projects.</span>
    {% endfor %}
  </div>
</div>

<div class="title_bar">
  <span class="title">{{ title }}</span>
  <span class="instance">{{ date }}</span>
</div>
