<div class="layout layout--col layout--top">
  <div class="col gap--small stretch-x">
    {% for p in active limit: 3 %}
      <div class="flex flex--row flex--between w--full">
        <span class="title title--small" data-clamp="1">{{ p.name }}</span>
        <span class="label no-shrink">{{ p.pct }}% done{% if p.idle != "" %} - {{ p.idle }}{% endif %}</span>
      </div>
    {% else %}
      <span class="title title--small">No active projects.</span>
    {% endfor %}
  </div>
</div>

<div class="title_bar">
  <span class="title">{{ title }}</span>
  <span class="instance">{{ date }}</span>
</div>
