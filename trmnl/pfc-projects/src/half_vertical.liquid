<div class="layout layout--col gap--small">
  <div class="col gap--medium stretch-x">
    <span class="label label--small">{{ horizon }}</span>
    {% for p in active limit: 6 %}
      <div class="flex flex--col flex--left gap--xsmall w--full">
        <span class="title title--small" data-clamp="1">{{ p.name }}</span>
        <div class="progress-bar progress-bar--xsmall w--full">
          <div class="track"><div class="fill w--[{{ p.pct }}cqw]"></div></div>
        </div>
        <span class="label label--small" data-clamp="2">{{ p.pct }}% done{% if p.next != "" %} - Next: {{ p.next }}{% endif %}</span>
      </div>
    {% else %}
      <span class="label">No active projects.</span>
    {% endfor %}
    <span class="label label--small">{{ on_deck }} on deck - {{ parked }} parked</span>
  </div>
</div>

<div class="title_bar">
  <span class="title">{{ title }}</span>
  <span class="instance">{{ date }}</span>
</div>
