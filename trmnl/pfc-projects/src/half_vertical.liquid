<div class="layout layout--col layout--top">
  <div class="col gap--medium stretch-x">
    <span class="label">{{ count }} active{% if stalled > 0 %}, {{ stalled }} stalled{% endif %}</span>
    {% for p in active %}
      <div class="flex flex--col flex--left gap--xsmall w--full">
        <span class="title title--small" data-clamp="1">{{ p.name }}</span>
        <span class="label" data-clamp="1">{{ p.pct }}% done{% if p.idle != "" %} - {{ p.idle }}{% endif %}</span>
      </div>
    {% endfor %}
  </div>
</div>

<div class="title_bar">
  <span class="title">{{ title }}</span>
  <span class="instance">{{ date }}</span>
</div>
