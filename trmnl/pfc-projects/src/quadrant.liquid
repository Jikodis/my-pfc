<div class="layout layout--col layout--top">
  <div class="col gap--xsmall stretch-x">
    <span class="label">{{ count }} active{% if stalled > 0 %}, {{ stalled }} stalled{% endif %}</span>
    {% for p in active limit: 3 %}
      <span class="label" data-clamp="1">{{ p.pct }}% {{ p.name }}</span>
    {% endfor %}
  </div>
</div>

<div class="title_bar">
  <span class="title">{{ title }}</span>
  <span class="instance">{{ date }}</span>
</div>
