<div class="layout layout--col gap--small">
  <div class="col gap--xsmall stretch-x">
    {% if total > 0 %}<span class="title title--small">{{ done }} of {{ total }} done</span>{% endif %}
    {% for pick in picks %}
      <span class="label" data-clamp="1">{% if pick.done %}[x]{% else %}[ ]{% endif %} {{ pick.title }}</span>
    {% else %}
      <span class="label" data-clamp="2">{{ picks_note }}</span>
      {% for n in needs_you limit: 2 %}
        <span class="label label--small" data-clamp="2">{{ n.title }} ({{ n.why }})</span>
      {% endfor %}
    {% endfor %}
  </div>
</div>

<div class="title_bar">
  <span class="title">{{ title }}</span>
  <span class="instance">{{ date }}</span>
</div>
