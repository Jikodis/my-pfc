<div class="layout layout--col layout--top">
  <div class="col gap--small stretch-x">
    {% for p in picks %}
      <span class="label" data-clamp="2">{{ p.kind }}{% if p.done %} (done){% endif %}: {{ p.title }}</span>
    {% else %}
      <span class="title title--small">{{ picks_note }}</span>
    {% endfor %}
  </div>
</div>

<div class="title_bar">
  <span class="title">{{ title }}</span>
  <span class="instance">{{ date }}</span>
</div>
