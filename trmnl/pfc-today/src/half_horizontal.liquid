<div class="layout layout--col layout--top">
  <div class="grid w--full">
    {% for p in picks limit: 3 %}
      <div class="col col--span-4 gap--xsmall">
        <span class="label">{{ p.kind }}{% if p.done %} - done{% endif %}</span>
        <span class="title title--small{% if p.done %} text--gray-50{% endif %}" data-clamp="3">{{ p.title }}</span>
      </div>
    {% else %}
      <div class="col col--span-12"><span class="title title--small">{{ picks_note }}</span></div>
    {% endfor %}
  </div>
</div>

<div class="title_bar">
  <span class="title">{{ title }}</span>
  <span class="instance">{{ date }}</span>
</div>
