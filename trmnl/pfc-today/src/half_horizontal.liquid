<div class="layout layout--col gap--small">
  <div class="col gap--xsmall stretch-x">
    <span class="label label--small" data-clamp="1">{{ horizon }}{% if total > 0 %} {{ done }} of {{ total }} done.{% endif %}</span>
    <div class="grid">
      <div class="col col--span-7 gap--xsmall">
        {% for pick in picks %}
          <span class="label" data-clamp="1">{% if pick.done %}[x]{% else %}[ ]{% endif %} {{ pick.kind }}: {{ pick.title }}</span>
        {% else %}
          <span class="label" data-clamp="1">{{ picks_note }}</span>
        {% endfor %}
        {% if evening %}
          <span class="label label--small" data-clamp="1">{{ tomorrow_label }}</span>
          {% for pick in tomorrow %}
            <span class="label label--small" data-clamp="1">[ ] {{ pick.kind }}: {{ pick.title }}</span>
          {% else %}
            <span class="label label--small">Not set yet.</span>
          {% endfor %}
        {% endif %}
      </div>
      <div class="col col--span-5 gap--xsmall">
        <span class="title title--small">What needs you</span>
        {% for n in needs_you limit: 3 %}
          <span class="label label--small" data-clamp="2">{{ n.title }} ({{ n.why }})</span>
        {% else %}
          <span class="label label--small">Nothing due.</span>
        {% endfor %}
        {% if handoffs.size > 0 %}
          <span class="label label--small" data-clamp="1">Hand to an agent: {{ handoffs.size }}</span>
        {% endif %}
      </div>
    </div>
  </div>
</div>

<div class="title_bar">
  <span class="title">{{ title }}</span>
  <span class="instance">{{ date }}</span>
</div>
