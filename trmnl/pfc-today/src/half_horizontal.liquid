<div class="layout layout--col gap--small">
  <div class="grid">
    <div class="col col--span-8">
      <div class="columns" data-overflow-max-cols="1">
        <div class="column">
          {% for task in critical %}
            <div class="item">
              <div class="meta">
                <span class="index">{{ forloop.index }}</span>
              </div>
              <div class="content">
                <span class="label" data-clamp="1">{% if task.done %}{{ done_mark }}{% else %}{{ open_mark }}{% endif %} {{ task.title }}</span>
              </div>
            </div>
          {% else %}
            <div class="item">
              <div class="meta"></div>
              <div class="content">
                <span class="label label--gray">No 2+1 set for today</span>
              </div>
            </div>
          {% endfor %}
          {% if bonus %}
            <div class="item">
              <div class="meta">
                <span class="index">+</span>
              </div>
              <div class="content">
                <span class="label" data-clamp="1">{% if bonus.done %}{{ done_mark }}{% else %}{{ open_mark }}{% endif %} {{ bonus.title }}</span>
              </div>
            </div>
          {% endif %}
        </div>
      </div>
    </div>

    <div class="col col--span-4">
      <div class="item">
        <div class="meta"></div>
        <div class="content">
          {% if last_rating %}
            <span class="value value--large">{{ last_rating }}/5</span>
            <span class="label label--small">Last day rating</span>
          {% else %}
            <span class="label label--small label--gray">No rating logged</span>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</div>

<div class="title_bar">
  <span class="title">{{ weekday }}</span>
  <span class="instance">2+1</span>
</div>
