<div class="layout layout--col layout--top">
  <div class="col gap--medium stretch-x">
    {% for p in picks %}
      <div class="flex flex--col flex--left gap--xsmall w--full">
        <span class="label">{{ p.kind }}{% if p.done %} - done{% endif %}</span>
        <span class="title title--small{% if p.done %} text--gray-50{% endif %}" data-clamp="3">{{ p.title }}</span>
        {% if p.note != "" %}<span class="label" data-clamp="1">{{ p.note }}</span>{% endif %}
      </div>
    {% else %}
      <span class="title title--small">{{ picks_note }}</span>
    {% endfor %}
    {% if total > 0 %}<span class="label">{{ done }} of {{ total }} picks done today</span>{% endif %}
    {% if needs.size > 0 %}<div class="flex flex--row flex--left gap--xsmall"><span class="label no-shrink">{% render "status_shape", status: "RED" %}</span><span class="label" data-clamp="2">{{ needs.first.title }}</span></div>{% endif %}
  </div>
</div>

<div class="title_bar">
  <span class="title">{{ title }}</span>
  <span class="instance">{{ date }}</span>
</div>
