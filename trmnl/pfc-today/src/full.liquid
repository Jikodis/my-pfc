<div class="layout layout--col gap">
  <div class="col gap--small stretch-x">
    <span class="description lg:description--large">{{ horizon }}{% if single_pick %} Lower the bar today: one pick, not 2+1.{% endif %}</span>
    <span class="title title--small lg:title--base">Today{% if total > 0 %}: {{ done }} of {{ total }} done{% endif %}</span>
    {% for pick in picks %}
      {% render "pick_row", pick: pick, text_class: "title title--small lg:title--base", clamp: 1 %}
    {% else %}
      <span class="title title--small lg:title--base">{{ picks_note }}</span>
    {% endfor %}
    {% if evening %}
      <span class="title title--small lg:title--base">{{ tomorrow_label }}</span>
      {% for pick in tomorrow %}
        {% render "pick_row", pick: pick, text_class: "label lg:label--large", clamp: 1 %}
      {% else %}
        <span class="label lg:label--large">Not set yet. Set them on the web page.</span>
      {% endfor %}
    {% endif %}
    {%- if evening -%}{%- assign room = 2 -%}{%- else -%}{%- assign room = 3 -%}{%- endif -%}
    <div class="divider"></div>
    <div class="grid">
      <div class="col col--span-6 gap--small">
        <span class="title title--small lg:title--base">What needs you</span>
        {% for n in needs_you limit: room %}
          <div class="item">
            <div class="meta"></div>
            <div class="content">
              <span class="label lg:label--large" data-clamp="2">{{ n.title }}</span>
              <span class="label lg:label--large">{{ n.why }}</span>
            </div>
          </div>
        {% else %}
          <span class="label lg:label--large">Nothing overdue or due soon.</span>
        {% endfor %}
      </div>
      <div class="col col--span-6 gap--small">
        <span class="title title--small lg:title--base">Hand to an agent</span>
        {% for h in handoffs limit: room %}
          <div class="item">
            <div class="meta"></div>
            <div class="content">
              <span class="label lg:label--large" data-clamp="2">{{ h }}</span>
            </div>
          </div>
        {% else %}
          <span class="label lg:label--large">Nothing to hand off.</span>
        {% endfor %}
      </div>
    </div>
  </div>
</div>

<div class="title_bar">
  <span class="title">{{ title }}</span>
  <span class="instance">{{ date }}</span>
</div>
