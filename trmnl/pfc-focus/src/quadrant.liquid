<div class="layout layout--col gap--small">
  <div class="col gap--xsmall stretch-x">
    {% for tier in tiers %}
      {% if tier.label == "Active Pursuits" %}
        <span class="title title--small">{{ tier.label }} ({{ tier.count }})</span>
        {% for row in tier.rows limit: 6 %}
          <span class="label" data-clamp="1">{{ row.status }} - {{ row.title }}{% if row.progress != "" %} ({{ row.progress }}){% endif %}</span>
        {% else %}
          <span class="label label--small">No active pursuits.</span>
        {% endfor %}
      {% endif %}
    {% endfor %}
  </div>
</div>

<div class="title_bar">
  <span class="title">{{ title }}</span>
  <span class="instance">{{ date }}</span>
</div>
