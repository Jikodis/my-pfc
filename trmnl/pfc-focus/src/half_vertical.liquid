<div class="layout layout--col gap--small">
  <div class="col gap--small stretch-x">
    <span class="label label--small">{{ horizon }}</span>
    {% if repick != "" %}
      <span class="label label--small label--filled" data-clamp="2">{{ repick }}</span>
    {% endif %}
    {% for tier in tiers %}
      <span class="title title--small">{{ tier.label }} ({{ tier.count }})</span>
      {% for row in tier.rows %}
        <span class="label" data-clamp="1">{{ row.status }} - {{ row.title }}{% if row.progress != "" %} ({{ row.progress }}){% endif %}</span>
      {% else %}
        <span class="label label--small">None.</span>
      {% endfor %}
    {% endfor %}
  </div>
</div>

<div class="title_bar">
  <span class="title">{{ title }}</span>
  <span class="instance">{{ date }}</span>
</div>
