<div class="layout layout--col layout--top">
  <div class="col gap--small stretch-x">
    <span class="value value--large">{{ red }} of {{ live }}</span>
    <span class="label">live focuses are red</span>
    {% for tier in tiers %}
      {% for f in tier.rows limit: 3 %}
        <div class="flex flex--row flex--left gap--xsmall"><span class="label no-shrink">{% render "status_shape", status: f.status %}</span><span class="label" data-clamp="1">{{ f.title }}</span></div>
      {% endfor %}
    {% endfor %}
  </div>
</div>

<div class="title_bar">
  <span class="title">{{ title }}</span>
  <span class="instance">{{ date }}</span>
</div>
