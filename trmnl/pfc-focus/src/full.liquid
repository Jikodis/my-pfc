<div class="layout layout--col layout--top">
  <div class="col gap--medium stretch-x">
    <div class="flex flex--col flex--left">
      <span class="value value--large lg:value--xlarge">{{ red }} of {{ live }}</span>
      <span class="label lg:label--large">live focuses are red</span>
    </div>
    {% if repick != "" %}<span class="label label--filled lg:label--large">{{ repick }}</span>{% endif %}
    <div class="grid w--full">
      {% for tier in tiers %}
        <div class="col col--span-4 gap--small">
          <span class="title title--small lg:title--base">{{ tier.label }}</span>
          {% for f in tier.rows %}
            <div class="flex flex--col flex--left gap--xsmall">
              <span class="title title--small lg:title--base" data-clamp="1">{{ f.title }}</span>
              <div class="flex flex--row flex--left gap--small">
                {% render "status_chip", status: f.status, size: "lg:label--large" %}
                <span class="label lg:label--large">{{ f.progress }}{% if f.weeks != "" %} - {{ f.weeks }}{% endif %}</span>
              </div>
            </div>
          {% endfor %}
          {% if tier.green > 0 %}<span class="label lg:label--large">{% render "status_shape", status: "GREEN" %} {{ tier.green }} going</span>{% endif %}
          {% if tier.parked > 0 %}<span class="label lg:label--large">{{ tier.parked }} parked</span>{% endif %}
          {% if tier.rows.size == 0 and tier.green == 0 and tier.parked == 0 %}<span class="label lg:label--large">None.</span>{% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</div>

<div class="title_bar">
  <span class="title">{{ title }}</span>
  <span class="instance">{{ date }}</span>
</div>
