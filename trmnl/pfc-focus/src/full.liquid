<div class="layout layout--col gap">
  <div class="col gap--small stretch-x">
    <span class="description lg:description--large">{{ horizon }}</span>
    {% if repick != "" %}
      <span class="label label--filled lg:label--large">{{ repick }}</span>
    {% endif %}
    <div class="grid">
      <div class="col col--span-6 gap--medium">
        {% for tier in tiers %}
          {% if tier.label != "Active Pursuits" %}
            <span class="title title--small lg:title--base">{{ tier.label }} ({{ tier.count }})</span>
            {% for row in tier.rows %}
              {% render "focus_row", row: row, title_class: "title title--small lg:title--base", label_class: "label lg:label--large" %}
            {% else %}
              <span class="label label--gray">None.</span>
            {% endfor %}
          {% endif %}
        {% endfor %}
      </div>
      <div class="col col--span-6 gap--medium">
        {% for tier in tiers %}
          {% if tier.label == "Active Pursuits" %}
            <span class="title title--small lg:title--base">{{ tier.label }} ({{ tier.count }})</span>
            {% for row in tier.rows %}
              {% render "focus_row", row: row, title_class: "title title--small lg:title--base", label_class: "label lg:label--large" %}
            {% else %}
              <span class="label label--gray">None.</span>
            {% endfor %}
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>
</div>

<div class="title_bar">
  <span class="title">{{ title }}</span>
  <span class="instance">{{ date }}</span>
</div>
