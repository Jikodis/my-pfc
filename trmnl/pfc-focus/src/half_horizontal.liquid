<div class="layout layout--col gap--small">
  <div class="col gap--xsmall stretch-x">
    <span class="label label--small" data-clamp="1">{% if repick != "" %}{{ repick }}{% else %}{{ horizon }}{% endif %}</span>
    <div class="grid">
      {% for tier in tiers %}
        <div class="col {% if tier.label == "Active Pursuits" %}col--span-5{% elsif tier.label == "Foundations" %}col--span-4{% else %}col--span-3{% endif %} gap--xsmall">
          <span class="title title--small" data-clamp="1">{{ tier.label }}</span>
          {% for row in tier.rows limit: 6 %}
            <span class="label label--small" data-clamp="1">{{ row.status }} - {{ row.title }}</span>
          {% else %}
            <span class="label label--small">None.</span>
          {% endfor %}
        </div>
      {% endfor %}
    </div>
  </div>
</div>

<div class="title_bar">
  <span class="title">{{ title }}</span>
  <span class="instance">{{ date }}</span>
</div>
