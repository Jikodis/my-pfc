<div class="layout layout--col layout--top">
  <div class="grid grid--cols-4 w--full">
    {% for d in days limit: 4 %}
      <div class="col gap--xsmall">
        <span class="title title--small">{{ d.label }}</span>
        {% for e in d.events limit: 2 %}
          <span class="label label--small" data-clamp="1">{{ e.time }} {{ e.title }}</span>
        {% else %}
          <span class="label label--small">Nothing scheduled.</span>
        {% endfor %}
      </div>
    {% endfor %}
  </div>
</div>

<div class="title_bar">
  <span class="title">{{ title }}</span>
  <span class="instance">{{ date }}</span>
</div>
