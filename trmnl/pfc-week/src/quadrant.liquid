<div class="layout layout--col layout--top">
  <div class="col gap--xsmall stretch-x">
    {% for d in days limit: 1 %}
      <span class="title title--small">{{ d.label }}</span>
      {% for e in d.events %}
        <span class="label" data-clamp="1">{{ e.time }} {{ e.title }}</span>
      {% else %}
        <span class="label">Nothing scheduled.</span>
      {% endfor %}
      {% if d.more > 0 %}<span class="label">{{ d.more }} more</span>{% endif %}
    {% endfor %}
  </div>
</div>

<div class="title_bar">
  <span class="title">{{ title }}</span>
  <span class="instance">{{ date }}</span>
</div>
