<div class="layout layout--col layout--top">
  <div class="grid grid--cols-4 gap--large w--full">
    {% for d in days %}
      <div class="col gap--xsmall">
        <span class="title title--small lg:title--base">{{ d.label }}</span>
        {% for e in d.events %}
          <span class="label lg:label--large" data-clamp="1">{{ e.time }} {{ e.title }}</span>
        {% else %}
          <span class="label lg:label--large">Nothing scheduled.</span>
        {% endfor %}
        {% if d.more > 0 %}<span class="label lg:label--large">{{ d.more }} more</span>{% endif %}
      </div>
    {% else %}
      <span class="title title--small">No calendar data yet.</span>
    {% endfor %}
  </div>
</div>

<div class="title_bar">
  <span class="title">{{ title }}</span>
  <span class="instance">{{ date }}</span>
</div>
