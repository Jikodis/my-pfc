<div class="layout layout--col gap">
  <div class="col gap--small">
    {% if stale and fetched != "" %}
      <span class="label label--small label--gray">Calendar data from {{ fetched }}</span>
    {% endif %}
    <div class="grid">
      <div class="col col--span-6 gap--small">
        {% for day in days limit: 4 %}
          <div class="item">
            <div class="meta"></div>
            <div class="content">
              <span class="title title--small lg:title--base">{{ day.label }}</span>
              {% for event in day.events %}
                <span class="label label--small lg:label--base" data-clamp="1">{{ event.time }} {{ event.title }}</span>
              {% else %}
                <span class="label label--small label--gray">free</span>
              {% endfor %}
            </div>
          </div>
        {% endfor %}
      </div>
      <div class="col col--span-6 gap--small">
        {% for day in days offset: 4 %}
          <div class="item">
            <div class="meta"></div>
            <div class="content">
              <span class="title title--small lg:title--base">{{ day.label }}</span>
              {% for event in day.events %}
                <span class="label label--small lg:label--base" data-clamp="1">{{ event.time }} {{ event.title }}</span>
              {% else %}
                <span class="label label--small label--gray">free</span>
              {% endfor %}
            </div>
          </div>
        {% else %}
          <div class="item">
            <div class="meta"></div>
            <div class="content">
              <span class="label label--gray">No events cached yet</span>
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</div>

<div class="title_bar">
  <span class="title">Week at a Glance</span>
  <span class="instance">{{ fetched }}</span>
</div>
