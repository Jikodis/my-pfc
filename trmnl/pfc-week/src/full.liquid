<div class="layout layout--col gap">
  <div class="col gap--small">
    <span class="label label--small lg:label--base label--gray 1bit:text--black">{{ horizon }}</span>
    {% if stale and fetched != "" %}
      <span class="label label--small label--gray 1bit:text--black">Calendar data from {{ fetched }}</span>
    {% endif %}
    <div class="columns" data-overflow-max-cols="3">
      <div class="column">
        {% for day in days %}
          <div class="item">
            <div class="meta"></div>
            <div class="content">
              <span class="title title--small lg:title--base">{{ day.label }}</span>
              {% for event in day.events %}
                <span class="label label--small lg:label--base" data-clamp="1">{{ event.time }} {{ event.title }}</span>
              {% else %}
                <span class="label label--small label--gray 1bit:text--black">free</span>
              {% endfor %}
              {% if day.more > 0 %}
                <span class="label label--small label--gray 1bit:text--black">+{{ day.more }} more</span>
              {% endif %}
            </div>
          </div>
        {% else %}
          <div class="item">
            <div class="meta"></div>
            <div class="content">
              <span class="label label--gray">No events cached yet</span>
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</div>

<div class="title_bar">
  <span class="title">{{ title }}</span>
  <span class="instance">{{ fetched }}</span>
</div>
