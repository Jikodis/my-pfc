<div class="layout layout--col layout--center">
  <div class="flex flex--col flex--center-x gap--medium w--full">
    {% for a in anchors limit: 3 %}
      <span class="title title--small text--center" data-clamp="1">{{ a }}</span>
    {% else %}
      <span class="title title--small">No active anchors.</span>
    {% endfor %}
  </div>
</div>

<div class="title_bar">
  <span class="title">{{ title }}</span>
  <span class="instance">{{ date }}</span>
</div>
