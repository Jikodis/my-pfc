<div class="layout layout--col layout--center">
  <div class="flex flex--col flex--center-x gap--xlarge w--full">
    {% for a in anchors %}
      {% if poster %}
        <span class="title title--large lg:title--xlarge text--center" data-clamp="2">{{ a }}</span>
      {% else %}
        <span class="title title--small lg:title--base" data-clamp="1">{{ a }}</span>
      {% endif %}
    {% else %}
      <span class="title title--base text--center">No active anchors.</span>
    {% endfor %}
  </div>
</div>

<div class="title_bar">
  <span class="title">{{ title }}</span>
  <span class="instance">{{ date }}</span>
</div>
