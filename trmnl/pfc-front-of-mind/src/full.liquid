{% if poster %}
  <div class="layout layout--col layout--stretch">
    <div class="flex flex--col gap stretch-y w--full">
      <span class="label label--small lg:label--base label--gray 1bit:text--black w--full">{{ horizon }}</span>
      <div class="flex flex--col flex--center gap grow">
        {% for anchor in anchors %}
          {% assign ts = anchor.text_size %}{% assign ts_lg = anchor.text_size_lg %}
          <span class="value value--{{ ts }} lg:value--{{ ts_lg }} text--center" data-clamp="4">{{ anchor.title }}</span>
          {% if anchor.area != "" %}
            <span class="label label--small lg:label--base label--gray 1bit:text--black">{{ anchor.area }}</span>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>
{% else %}
  <div class="layout layout--col gap">
    <div class="col gap--small">
      <span class="label label--small lg:label--base label--gray 1bit:text--black">{{ horizon }}</span>
      <div class="columns" data-overflow-max-cols="2">
        <div class="column">
          {% for anchor in anchors %}
            <div class="item">
              <div class="meta">
                <span class="index">{{ forloop.index }}</span>
              </div>
              <div class="content">
                <span class="title title--small lg:title--base" data-clamp="2">{{ anchor.title }}</span>
                {% if anchor.area != "" %}
                  <span class="label label--small lg:label--base label--gray 1bit:text--black">{{ anchor.area }}</span>
                {% endif %}
              </div>
            </div>
          {% endfor %}
        </div>
      </div>
    </div>
  </div>
{% endif %}

<div class="title_bar">
  <span class="title">{{ title }}</span>
  <span class="instance">{{ count }} anchor{% if count != 1 %}s{% endif %}</span>
</div>
