<div class="layout layout--col gap">
  <div class="col gap--small">
    <div class="columns" data-overflow-max-cols="1">
      <div class="column">
        {% for anchor in anchors_rotated limit: 5 %}
          <div class="item">
            <div class="meta"></div>
            <div class="content">
              <span class="label" data-clamp="2">{{ anchor.title }}</span>
            </div>
          </div>
        {% else %}
          <div class="item">
            <div class="meta"></div>
            <div class="content">
              <span class="label label--gray">No active anchors</span>
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</div>

<div class="title_bar">
  <span class="title">Front of Mind</span>
  <span class="instance">{{ count }}</span>
</div>
