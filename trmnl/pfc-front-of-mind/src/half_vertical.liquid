<div class="layout layout--col layout--center">
  <div class="flex flex--col flex--center-x gap--large w--full">
    {% for a in anchors limit: 4 %}
      <span class="title title--small text--center" data-clamp="3">{{ a }}</span>
    {% else %}
      <span class="title title--small">No active anchors.</span>
    {% endfor %}
  </div>
</div>

<div class="title_bar">
  <span class="title">{{ title }}</span>
  <span class="instance">{{ date }}</span>
</div>
