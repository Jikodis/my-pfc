<div class="layout layout--col gap--small">
  <div class="col gap--small stretch-x">
    <span class="label label--small">{{ horizon }}</span>
    <span class="label" data-clamp="1">Sleep: {{ sleep }}</span>
    {% if broken_night %}<span class="label label--small label--filled">Broken night</span>{% endif %}
    <span class="label" data-clamp="1">{{ exercise_label }}: {{ exercise }} {{ exercise_status }}</span>
    <span class="label label--small" data-clamp="1">{{ exercise_month }}</span>
    <span class="title title--small" data-clamp="2">{{ verdict_status }} - {{ verdict }}</span>
    {% if move != "" %}<span class="label label--small" data-clamp="2">Tonight: {{ move }}</span>{% endif %}
    {% for lever in levers limit: 6 %}
      <span class="label label--small" data-clamp="1">{{ lever.status }} - {{ lever.label }} {{ lever.value }} - {{ lever.month }}</span>
    {% endfor %}
  </div>
</div>

<div class="title_bar">
  <span class="title">{{ title }}</span>
  <span class="instance">{{ date }}</span>
</div>
