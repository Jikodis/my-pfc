<div class="layout layout--col layout--top">
  <div class="col gap--medium stretch-x">
    <div class="flex flex--row flex--left">{% render "status_chip", status: verdict_status, size: "" %}</div>
    <span class="title title--base" data-clamp="3">{{ verdict }}</span>
    <span class="label">Slept {{ sleep }}{% if broken_night %}, broken{% endif %} - {{ exercise_label }}: {{ exercise }}</span>
    {% for lever in levers %}
      <div class="flex flex--row flex--left gap--xsmall"><span class="label no-shrink">{% render "status_shape", status: lever.status %}</span><span class="label" data-clamp="1">{{ lever.label }} {{ lever.value }} (target {{ lever.target }})</span></div>
    {% endfor %}
    {% if has_levers %}<span class="label">{% render "status_shape", status: "GREEN" %} {{ on_target }} on target</span>{% endif %}
  </div>
</div>

<div class="title_bar">
  <span class="title">{{ title }}</span>
  <span class="instance">{{ date }}</span>
</div>
