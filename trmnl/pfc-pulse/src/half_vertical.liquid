<div class="layout layout--col gap">
  <div class="col gap--small">
    <span class="title title--small">{{ verdict_mark }} - {{ verdict }}</span>
    <div class="columns" data-overflow-max-cols="1">
      <div class="column">
        {% for lever in levers %}
          {% if lever.tier == "CRITICAL" %}
            <div class="item">
              <div class="meta"></div>
              <div class="content">
                <span class="label" data-clamp="1">{{ lever.mark }} - {{ lever.label }}: {{ lever.value }}</span>
              </div>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
    <span class="label label--small" data-clamp="3">Tonight: {{ move }}</span>
  </div>
</div>

<div class="title_bar">
  <span class="title">Daily Pulse</span>
  <span class="instance">{{ date }}</span>
</div>
