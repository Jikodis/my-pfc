<div class="layout layout--col gap--small">
  <div class="grid">
    <div class="col col--span-5">
      <div class="item">
        <div class="meta"></div>
        <div class="content">
          <span class="title title--small" data-clamp="3">{{ verdict_mark }} - {{ verdict }}</span>
        </div>
      </div>
    </div>
    <div class="col col--span-7">
      <div class="item">
        <div class="meta"></div>
        <div class="content">
          <span class="label label--small">Tonight's one move</span>
          <span class="label" data-clamp="3">{{ move }}</span>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="title_bar">
  <span class="title">Daily Pulse</span>
  <span class="instance">{{ date }}</span>
</div>
