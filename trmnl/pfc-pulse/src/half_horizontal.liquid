<div class="layout layout--col gap--small">
  <div class="col gap--xsmall stretch-x">
    <span class="label label--small" data-clamp="1">{{ horizon }}</span>
    <div class="grid">
      <div class="col col--span-6 gap--xsmall">
        <span class="label" data-clamp="1">Sleep: {{ sleep }}</span>
        {% if broken_night %}<span class="label label--small" data-clamp="1">Broken night.</span>{% endif %}
        <span class="label" data-clamp="1">{{ exercise_label }}: {{ exercise_status }}, {{ exercise_month }}</span>
        <span class="title title--small" data-clamp="2">{{ verdict_status }} - {{ verdict }}</span>
        {% if single_pick != "" %}<span class="label label--small" data-clamp="1">{{ single_pick }}</span>{% endif %}
      </div>
      <div class="col col--span-6 gap--xsmall">
        {% for lever in levers limit: 6 %}
          <span class="label label--small" data-clamp="1">{{ lever.status }} - {{ lever.label }} {{ lever.value }}, {{ lever.month }} nights</span>
        {% else %}
          <span class="label">No sleep data yet.</span>
        {% endfor %}
      </div>
    </div>
  </div>
</div>

<div class="title_bar">
  <span class="title">{{ title }}</span>
  <span class="instance">{{ date }}</span>
</div>
