<div class="layout layout--col layout--top">
  <div class="grid w--full">
    <div class="col col--span-6 gap--small">
      <div class="flex flex--row flex--left">{% render "status_chip", status: verdict_status, size: "" %}</div>
      <span class="title title--small" data-clamp="2">{{ verdict }}</span>
      <span class="label">Slept {{ sleep }}{% if broken_night %}, broken{% endif %} - {{ exercise_label }}: {{ exercise }}</span>
    </div>
    <div class="col col--span-6 gap--xsmall">
      {% for lever in levers limit: 3 %}
        <div class="flex flex--row flex--left gap--xsmall"><span class="label no-shrink">{% render "status_shape", status: lever.status %}</span><span class="label" data-clamp="1">{{ lever.label }} {{ lever.value }}</span></div>
      {% endfor %}
      {% if has_levers %}<span class="label">{% render "status_shape", status: "GREEN" %} {{ on_target }} on target</span>{% endif %}
    </div>
  </div>
</div>

<div class="title_bar">
  <span class="title">{{ title }}</span>
  <span class="instance">{{ date }}</span>
</div>
