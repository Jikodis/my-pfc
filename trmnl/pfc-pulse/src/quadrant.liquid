<div class="layout layout--col gap--small">
  <div class="col gap--xsmall stretch-x">
    <span class="title title--small" data-clamp="2">{{ verdict_status }} - {{ verdict }}</span>
    <span class="label" data-clamp="1">Sleep: {{ sleep }}{% if broken_night %}, broken{% endif %}</span>
    <span class="label" data-clamp="1">{{ exercise_label }}: {{ exercise }} {{ exercise_month }}</span>
    {% if move != "" %}<span class="label label--small" data-clamp="2">Tonight: {{ move }}</span>{% endif %}
  </div>
</div>

<div class="title_bar">
  <span class="title">{{ title }}</span>
  <span class="instance">{{ date }}</span>
</div>
