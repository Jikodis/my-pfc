<div class="layout layout--col gap--small">
  <div class="columns" data-overflow-max-cols="1">
    <div class="column">
      <div class="item">
        <div class="meta"></div>
        <div class="content">
          <span class="label" data-clamp="2">{{ verdict_mark }} - {{ verdict }}</span>
        </div>
      </div>
      <div class="item">
        <div class="meta"></div>
        <div class="content">
          <span class="label label--small" data-clamp="2">Tonight: {{ move }}</span>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="title_bar">
  <span class="title">Pulse</span>
  <span class="instance">{{ date }}</span>
</div>
