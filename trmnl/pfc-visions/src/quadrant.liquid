<div class="layout layout--col layout--center gap--small">
  <span class="label label--small label--gray 1bit:text--black">Today's vision</span>
  <span class="title title--large text--center" data-clamp="2">{{ today_title }}</span>
  {% if today_value != "" %}
    <span class="label label--small label--outline">Serves {{ today_value }}</span>
  {% endif %}
</div>

<div class="title_bar">
  <span class="title">{{ title }}</span>
  <span class="instance">{{ count }} active</span>
</div>
