<div class="layout layout--col gap">
  <div class="col gap--small">
    <span class="label label--small label--gray 1bit:text--black">{{ horizon }}</span>
    <span class="label label--small label--gray 1bit:text--black">Today's vision</span>
    <span class="title title--large" data-clamp="2">{{ today_title }}</span>
    {% if today_value != "" %}
      <div class="flex flex--row flex--left"><span class="label label--small label--outline">Serves {{ today_value }}</span></div>
    {% endif %}
    <div class="divider"></div>
    <div class="flex flex--col flex--left gap--xsmall">
        {% for vision in visions %}
          {% unless vision.today %}
            <span class="label" data-clamp="1">{{ vision.title }}</span>
          {% endunless %}
        {% endfor %}
      </div>
  </div>
</div>

<div class="title_bar">
  <span class="title">{{ title }}</span>
  <span class="instance">{{ count }} active</span>
</div>
