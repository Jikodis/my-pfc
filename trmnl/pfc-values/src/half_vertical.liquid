<div class="layout layout--col gap--space-between">
  <span class="label label--small label--gray 1bit:text--black">{{ horizon }}</span>
  <div class="flex flex--row flex--wrap flex--center gap--small">
    {% for value in values %}
      <span class="label label--outline">{{ forloop.index }}. {{ value }}</span>
    {% endfor %}
  </div>
  <div class="divider"></div>
  <div class="flex flex--col flex--center-x gap--small text--center">
    <span class="label label--small label--gray 1bit:text--black">Question of the day</span>
    {% if question != "" %}
      <span class="description description--large" data-clamp="4">{{ question }}</span>
    {% else %}
      <span class="description label--gray 1bit:text--black">No open questions.</span>
    {% endif %}
  </div>
</div>

<div class="title_bar">
  <span class="title">{{ title }}</span>
  <span class="instance">{{ date }}</span>
</div>
